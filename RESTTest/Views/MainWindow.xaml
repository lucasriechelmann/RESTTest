<ui:FluentWindow x:Class="RESTTest.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:be="clr-namespace:RESTTest.Behaviors"
                 xmlns:ctrl="clr-namespace:RESTTest.Controls"
                 xmlns:vm="clr-namespace:RESTTest.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
                 Title="RESTTest"
                 Icon="pack://application:,,,/Assets/app.ico"
                 Width="1320"
                 Height="860"
                 MinWidth="1040"
                 MinHeight="640"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Return" Modifiers="Ctrl" Command="{Binding SendCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewRequestCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl+Shift" Command="{Binding NewFolderCommand}" />
        <KeyBinding Key="H" Modifiers="Ctrl" Command="{Binding ShowHistoryCommand}" />
    </ui:FluentWindow.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="RESTTest">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- ================= Collection and environment bar ================= -->
        <!--
            Both combo boxes are star-sized with a minimum, so at the smallest window width neither
            collapses to a bare chevron. The three actions on the right are icon-only (with tooltips
            and automation names) to leave the room: text buttons there used to push the Base URL
            combo down to nothing.
        -->
        <Border Grid.Row="1"
                Padding="12,2,12,10"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1.2*" MinWidth="150" MaxWidth="300" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" MinWidth="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Collection" />

                <ComboBox Grid.Column="1"
                          DisplayMemberPath="Name"
                          ItemsSource="{Binding Collections}"
                          SelectedItem="{Binding SelectedCollection, Mode=TwoWay}"
                          ToolTip="{Binding SelectedCollection.Name}" />

                <ui:Button Grid.Column="2"
                           Margin="6,0,0,0"
                           Padding="8"
                           AutomationProperties.Name="New collection"
                           Command="{Binding NewCollectionCommand}"
                           ToolTip="New collection">
                    <ui:SymbolIcon Symbol="Add24" />
                </ui:Button>

                <ui:Button Grid.Column="3"
                           Margin="4,0,0,0"
                           Padding="8"
                           AutomationProperties.Name="Rename collection"
                           Command="{Binding RenameCollectionCommand}"
                           ToolTip="Rename collection">
                    <ui:SymbolIcon Symbol="Rename24" />
                </ui:Button>

                <ui:Button Grid.Column="4"
                           Margin="4,0,0,0"
                           Padding="8"
                           AutomationProperties.Name="Delete collection"
                           Command="{Binding DeleteCollectionCommand}"
                           ToolTip="Delete collection">
                    <ui:SymbolIcon Symbol="Delete24" />
                </ui:Button>

                <Border Grid.Column="5"
                        Width="1"
                        Margin="12,4"
                        Background="{DynamicResource CardStrokeColorDefaultBrush}" />

                <TextBlock Grid.Column="6"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Base URL" />

                <!--
                    The collection-wide URL switch. Changing it re-targets every request in the
                    collection, which is the main difference from Postman's per-request URLs.
                -->
                <ComboBox Grid.Column="7"
                          DisplayMemberPath="Display"
                          ItemsSource="{Binding SelectedCollection.Environments}"
                          SelectedItem="{Binding SelectedCollection.ActiveEnvironment, Mode=TwoWay}"
                          ToolTip="{Binding SelectedCollection.ActiveEnvironment.Display}" />

                <ui:Button Grid.Column="8"
                           Margin="6,0,0,0"
                           Padding="8"
                           AutomationProperties.Name="Manage base URLs"
                           Command="{Binding ManageEnvironmentsCommand}"
                           ToolTip="Manage base URLs">
                    <ui:SymbolIcon Symbol="Link24" />
                </ui:Button>

                <ui:Button Grid.Column="9"
                           Margin="4,0,0,0"
                           Padding="8"
                           AutomationProperties.Name="Request history"
                           Command="{Binding ShowHistoryCommand}"
                           ToolTip="Request history (Ctrl+H)">
                    <ui:SymbolIcon Symbol="History24" />
                </ui:Button>

                <ui:Button Grid.Column="10"
                           Margin="4,0,0,0"
                           Padding="8"
                           AutomationProperties.Name="Cookies"
                           Command="{Binding ShowCookiesCommand}"
                           ToolTip="Cookies kept between requests">
                    <ui:SymbolIcon Symbol="Cookies24" />
                </ui:Button>

                <ui:Button Grid.Column="11"
                           Margin="4,0,0,0"
                           Padding="8"
                           AutomationProperties.Name="Import cURL"
                           Command="{Binding ImportCurlCommand}"
                           ToolTip="Import a request from a cURL command">
                    <ui:SymbolIcon Symbol="ArrowDownload24" />
                </ui:Button>
            </Grid>
        </Border>

        <!-- ================= Sidebar + editor ================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" MinWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="460" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- A WrapPanel: a narrow sidebar moves the last button to a second line instead of clipping it. -->
                    <WrapPanel Grid.Row="0" Margin="10,10,4,4">
                        <ui:Button Margin="0,0,6,6"
                                   Command="{Binding NewRequestCommand}"
                                   Content="Request"
                                   ToolTip="New request (Ctrl+N)">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="DocumentAdd24" />
                            </ui:Button.Icon>
                        </ui:Button>

                        <ui:Button Margin="0,0,6,6"
                                   Command="{Binding NewFolderCommand}"
                                   Content="Folder"
                                   ToolTip="New folder (Ctrl+Shift+N)">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="FolderAdd24" />
                            </ui:Button.Icon>
                        </ui:Button>

                        <ui:Button Margin="0,0,6,6"
                                   Command="{Binding RunSelectedCommand}"
                                   Content="Run"
                                   ToolTip="Run every request in the selected folder, or in the whole collection, and check their tests">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Play24" />
                            </ui:Button.Icon>
                        </ui:Button>

                        <ui:Button Margin="0,0,6,6"
                                   Command="{Binding ImportCollectionCommand}"
                                   Content="Import"
                                   ToolTip="Import a Postman, Insomnia or OpenAPI file as a new collection">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowImport24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </WrapPanel>

                    <TreeView Grid.Row="1"
                              Padding="4,0,4,8"
                              AllowDrop="True"
                              Background="Transparent"
                              BorderThickness="0"
                              HorizontalContentAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ItemsSource="{Binding SelectedCollection.Items}"
                              be:TreeViewDragDrop.Handler="{Binding}"
                              be:TreeViewSelection.SelectOnRightClick="True"
                              be:TreeViewSelection.SelectedItem="{Binding SelectedNode, Mode=TwoWay}">

                        <TreeView.InputBindings>
                            <!-- Scoped to the tree so they cannot fire while typing in the editors. -->
                            <KeyBinding Key="F2" Command="{Binding RenameSelectedCommand}" />
                            <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
                        </TreeView.InputBindings>

                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding NewRequestCommand}" Header="New Request" />
                                <MenuItem Command="{Binding NewFolderCommand}" Header="New Folder" />
                                <Separator />
                                <MenuItem Command="{Binding RunSelectedCommand}" Header="Run" />
                                <MenuItem Command="{Binding ImportCurlCommand}" Header="Import cURL..." />
                                <MenuItem Command="{Binding ImportCollectionCommand}" Header="Import collection file..." />
                                <MenuItem Command="{Binding CopyAsCurlCommand}" Header="Copy as cURL" />
                                <Separator />
                                <MenuItem Command="{Binding RenameSelectedCommand}" Header="Rename" InputGestureText="F2" />
                                <MenuItem Command="{Binding DuplicateSelectedCommand}" Header="Duplicate" />
                                <Separator />
                                <MenuItem Command="{Binding DeleteSelectedCommand}" Header="Delete" InputGestureText="Del" />
                            </ContextMenu>
                        </TreeView.ContextMenu>

                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <!--
                                    Without Stretch the header is only as wide as its label, so the
                                    NodeRow the drag-and-drop behavior hit-tests against stops at the
                                    end of the text and the rest of the row is dead space.
                                -->
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </TreeView.ItemContainerStyle>

                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <!--
                                    NodeRow is the hit-test anchor the drag-and-drop behavior looks
                                    for. It must wrap the row only: an expanded TreeViewItem's own
                                    bounds include its children, which would break the
                                    before/inside/after calculation.
                                -->
                                <Border x:Name="NodeRow"
                                        ToolTip="{Binding Name}"
                                        MinHeight="28"
                                        Padding="2,3"
                                        Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <ui:SymbolIcon Grid.Column="0"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="16"
                                                       Symbol="Folder24"
                                                       Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}" />

                                        <TextBlock Grid.Column="0"
                                                   MinWidth="40"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding MethodLabel, Converter={StaticResource MethodBrush}}"
                                                   Text="{Binding MethodLabel}"
                                                   TextAlignment="Right"
                                                   Visibility="{Binding IsRequest, Converter={StaticResource BoolToVis}}" />

                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVis}}" />

                                        <TextBox Grid.Column="1"
                                                 Padding="4,1"
                                                 VerticalAlignment="Center"
                                                 be:FocusBehavior.FocusOnVisible="True"
                                                 be:FocusBehavior.LostFocusCommand="{Binding CommitRenameCommand}"
                                                 Text="{Binding RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding CommitRenameCommand}" />
                                                <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </Grid>
                                </Border>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext" />

            <!-- ================= Request editor ================= -->
            <Grid Grid.Column="2">
                <!-- Shown when a folder, or nothing, is selected. -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding HasActiveRequest, Converter={StaticResource InverseBoolToVis}}">
                    <ui:SymbolIcon HorizontalAlignment="Center"
                                   FontSize="40"
                                   Opacity="0.45"
                                   Symbol="Send24" />
                    <TextBlock Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Select a request on the left, or create one." />
                </StackPanel>

                <Grid Visibility="{Binding HasActiveRequest, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="230" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="140" />
                    </Grid.RowDefinitions>

                    <!-- Method, path, send -->
                    <Grid Grid.Row="0" Margin="12,12,12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding Methods}"
                                  SelectedItem="{Binding ActiveRequest.Method, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{Binding Converter={StaticResource MethodBrush}}"
                                               Text="{Binding}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <ui:TextBox Grid.Column="1"
                                    Margin="8,0,0,0"
                                    FontFamily="{StaticResource CodeFont}"
                                    PlaceholderText="/api/resource"
                                    Text="{Binding ActiveRequest.Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <ui:Button Grid.Column="2"
                                   MinWidth="96"
                                   Margin="8,0,0,0"
                                   Appearance="Primary"
                                   Command="{Binding SendCommand}"
                                   Content="Send"
                                   ToolTip="Send (Ctrl+Enter)" />

                        <ui:Button Grid.Column="3"
                                   Margin="6,0,0,0"
                                   Padding="8"
                                   Command="{Binding CancelSendCommand}"
                                   ToolTip="Cancel"
                                   Visibility="{Binding IsSending, Converter={StaticResource BoolToVis}}">
                            <ui:SymbolIcon Symbol="Stop24" />
                        </ui:Button>
                    </Grid>

                    <!-- Resolved URL preview: base URL + path + enabled query parameters -->
                    <Grid Grid.Row="1" Margin="12,0,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource CodeFont}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding ResolvedUrl}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ResolvedUrl}" />

                        <ui:Button Grid.Column="1"
                                   Padding="6,2"
                                   Command="{Binding CopyResolvedUrlCommand}"
                                   ToolTip="Copy the resolved URL">
                            <ui:SymbolIcon FontSize="14" Symbol="Copy24" />
                        </ui:Button>

                        <ui:Button Grid.Column="2"
                                   Margin="4,0,0,0"
                                   Padding="8,2"
                                   Command="{Binding CopyAsCurlCommand}"
                                   Content="cURL"
                                   FontSize="12"
                                   ToolTip="Copy this request as a cURL command" />
                    </Grid>

                    <!-- Request detail tabs: everything inside is scoped to the request -->
                    <TabControl Grid.Row="2"
                                Margin="12,0,12,0"
                                DataContext="{Binding ActiveRequest}">

                        <TabItem Header="Body">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Body type, then the actions and notes that apply to it. -->
                                <WrapPanel Grid.Row="0" Margin="0,0,0,2">
                                    <ComboBox Width="190"
                                              ItemsSource="{Binding BodyOptions}"
                                              SelectedItem="{Binding BodyMode, Mode=TwoWay}"
                                              ToolTip="How the body is encoded and which Content-Type it is sent with">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource BodyKindLabel}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding CanFormatBody, Converter={StaticResource BoolToVis}}">
                                        <ui:Button Margin="8,0,0,0"
                                                   Command="{Binding FormatBodyCommand}"
                                                   Content="Format">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="TextAlignLeft24" />
                                            </ui:Button.Icon>
                                        </ui:Button>

                                        <ui:Button Margin="6,0,0,0"
                                                   Command="{Binding MinifyBodyCommand}"
                                                   Content="Minify" />
                                    </StackPanel>

                                    <TextBlock Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding BodyStatus}"
                                               Visibility="{Binding BodyStatus, Converter={StaticResource StringToVis}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BodyStatusIsError}" Value="True">
                                                        <Setter Property="Foreground" Value="#D9534F" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="This method does not send a body."
                                               Visibility="{Binding SupportsBody, Converter={StaticResource InverseBoolToVis}}" />
                                </WrapPanel>

                                <Grid Grid.Row="1">
                                    <!-- JSON, and Text / XML: same text, two editors that differ only in colouring. -->
                                    <ctrl:JsonEditor BoundText="{Binding Body, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource JsonEditorStyle}"
                                                     Visibility="{Binding IsJsonBody, Converter={StaticResource BoolToVis}}" />

                                    <ctrl:JsonEditor BoundText="{Binding Body, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     HighlightJson="False"
                                                     Style="{StaticResource JsonEditorStyle}"
                                                     Visibility="{Binding IsPlainTextBody, Converter={StaticResource BoolToVis}}" />

                                    <!-- Form (urlencoded) -->
                                    <Grid Visibility="{Binding IsFormBody, Converter={StaticResource BoolToVis}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="1.4*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource SectionLabelStyle}" Text="Field" />
                                            <TextBlock Grid.Column="2" Margin="8,0,0,6" Style="{StaticResource SectionLabelStyle}" Text="Value" />
                                            <TextBlock Grid.Column="3" Width="40" Text="" />
                                        </Grid>

                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl Margin="0,0,10,0" ItemsSource="{Binding FormFields}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="44" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="1.4*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <CheckBox Grid.Column="0"
                                                                      VerticalAlignment="Center"
                                                                      IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                                      ToolTip="Send this field" />

                                                            <ui:TextBox Grid.Column="1"
                                                                        FontFamily="{StaticResource CodeFont}"
                                                                        PlaceholderText="name"
                                                                        Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                            <ui:TextBox Grid.Column="2"
                                                                        Margin="8,0,0,0"
                                                                        FontFamily="{StaticResource CodeFont}"
                                                                        PlaceholderText="value"
                                                                        Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                            <ui:Button Grid.Column="3"
                                                                       Margin="8,0,0,0"
                                                                       Padding="6"
                                                                       Command="{Binding DataContext.RemoveFormFieldCommand,
                                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                       CommandParameter="{Binding}"
                                                                       ToolTip="Remove">
                                                                <ui:SymbolIcon FontSize="14" Symbol="Delete24" />
                                                            </ui:Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <ui:Button Grid.Row="2"
                                                   Margin="0,8,0,0"
                                                   HorizontalAlignment="Left"
                                                   Command="{Binding AddFormFieldCommand}"
                                                   Content="Add field">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Add24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </Grid>

                                    <!-- Form (multipart): text fields and files -->
                                    <Grid Visibility="{Binding IsMultipartBody, Converter={StaticResource BoolToVis}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="78" />
                                                <ColumnDefinition Width="1.6*" />
                                                <ColumnDefinition Width="132" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource SectionLabelStyle}" Text="Field" />
                                            <TextBlock Grid.Column="2" Margin="8,0,0,6" Style="{StaticResource SectionLabelStyle}" Text="Type" />
                                            <TextBlock Grid.Column="3" Margin="8,0,0,6" Style="{StaticResource SectionLabelStyle}" Text="Value or file path" />
                                            <TextBlock Grid.Column="4" Text="" />
                                        </Grid>

                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl Margin="0,0,10,0" ItemsSource="{Binding MultipartParts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="44" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="78" />
                                                                <ColumnDefinition Width="1.6*" />
                                                                <ColumnDefinition Width="132" />
                                                            </Grid.ColumnDefinitions>

                                                            <CheckBox Grid.Column="0"
                                                                      VerticalAlignment="Center"
                                                                      IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                                      ToolTip="Send this part" />

                                                            <ui:TextBox Grid.Column="1"
                                                                        FontFamily="{StaticResource CodeFont}"
                                                                        PlaceholderText="name"
                                                                        Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                            <CheckBox Grid.Column="2"
                                                                      Width="70"
                                                                      Margin="8,0,0,0"
                                                                      VerticalAlignment="Center"
                                                                      Content="File"
                                                                      IsChecked="{Binding IsFile, Mode=TwoWay}"
                                                                      ToolTip="Upload a file instead of sending text" />

                                                            <ui:TextBox Grid.Column="3"
                                                                        Margin="8,0,0,0"
                                                                        FontFamily="{StaticResource CodeFont}"
                                                                        PlaceholderText="value"
                                                                        Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                            <StackPanel Grid.Column="4" HorizontalAlignment="Right" Orientation="Horizontal">
                                                                <ui:Button Margin="8,0,0,0"
                                                                           Command="{Binding DataContext.PickMultipartFileCommand,
                                                                                              RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                                           CommandParameter="{Binding}"
                                                                           Content="Browse"
                                                                           Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}" />

                                                                <ui:Button Margin="8,0,0,0"
                                                                           Padding="6"
                                                                           Command="{Binding DataContext.RemoveMultipartPartCommand,
                                                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                           CommandParameter="{Binding}"
                                                                           ToolTip="Remove">
                                                                    <ui:SymbolIcon FontSize="14" Symbol="Delete24" />
                                                                </ui:Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <ui:Button Grid.Row="2"
                                                   Margin="0,8,0,0"
                                                   HorizontalAlignment="Left"
                                                   Command="{Binding AddMultipartPartCommand}"
                                                   Content="Add part">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Add24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </Grid>

                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="This request has no body."
                                               Visibility="{Binding IsNoBody, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Auth">
                            <!-- Scrolls: the Basic and API key forms are taller than the request pane at the minimum window size. -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,14,12,8" MaxWidth="560" HorizontalAlignment="Left">
                                <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Type" />
                                <ComboBox Width="260"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding AuthOptions}"
                                          SelectedItem="{Binding Auth, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource AuthKindLabel}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <StackPanel Margin="0,16,0,0"
                                            Visibility="{Binding IsBearerAuth, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Token" />
                                    <ui:TextBox FontFamily="{StaticResource CodeFont}"
                                                PlaceholderText="eyJhbGciOi..."
                                                Text="{Binding BearerToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="0,8,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="Sent as: Authorization: Bearer &lt;token&gt;" />
                                </StackPanel>

                                <StackPanel Margin="0,16,0,0"
                                            Visibility="{Binding IsBasicAuth, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Username" />
                                    <ui:TextBox Text="{Binding BasicUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Style="{StaticResource SectionLabelStyle}"
                                               Margin="0,12,0,0"
                                               Text="Password" />
                                    <ui:TextBox Text="{Binding BasicPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Margin="0,8,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="Sent as: Authorization: Basic base64(username:password)"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Margin="0,16,0,0"
                                            Visibility="{Binding IsApiKeyAuth, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Add to" />
                                    <ComboBox Width="260"
                                              HorizontalAlignment="Left"
                                              ItemsSource="{Binding ApiKeyLocationOptions}"
                                              SelectedItem="{Binding ApiKeyPlacement, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource ApiKeyLocationLabel}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Style="{StaticResource SectionLabelStyle}"
                                               Margin="0,12,0,0"
                                               Text="Name" />
                                    <ui:TextBox FontFamily="{StaticResource CodeFont}"
                                                PlaceholderText="X-API-Key"
                                                Text="{Binding ApiKeyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Style="{StaticResource SectionLabelStyle}"
                                               Margin="0,12,0,0"
                                               Text="Value" />
                                    <ui:TextBox FontFamily="{StaticResource CodeFont}"
                                                Text="{Binding ApiKeyValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Margin="0,8,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding ApiKeyHint}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Params" />
                                    <TextBlock Opacity="0.7" Text="{Binding EnabledQueryParamCount, StringFormat=' ({0})'}" />
                                </StackPanel>
                            </TabItem.Header>

                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SectionLabelStyle}" Text="Key" />
                                    <TextBlock Grid.Column="2" Margin="8,0,0,6" Style="{StaticResource SectionLabelStyle}" Text="Value" />
                                    <TextBlock Grid.Column="3" Width="40" Text="" />
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl Margin="0,0,10,0" ItemsSource="{Binding QueryParams}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="1.4*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                              ToolTip="Include this parameter" />

                                                    <ui:TextBox Grid.Column="1"
                                                                FontFamily="{StaticResource CodeFont}"
                                                                PlaceholderText="key"
                                                                Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                    <ui:TextBox Grid.Column="2"
                                                                Margin="8,0,0,0"
                                                                FontFamily="{StaticResource CodeFont}"
                                                                PlaceholderText="value"
                                                                Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                    <ui:Button Grid.Column="3"
                                                               Margin="8,0,0,0"
                                                               Padding="6"
                                                               Command="{Binding DataContext.RemoveQueryParamCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding}"
                                                               ToolTip="Remove">
                                                        <ui:SymbolIcon FontSize="14" Symbol="Delete24" />
                                                    </ui:Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <ui:Button Grid.Row="2"
                                           Margin="0,8,0,0"
                                           HorizontalAlignment="Left"
                                           Command="{Binding AddQueryParamCommand}"
                                           Content="Add parameter">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Add24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                        </TabItem>

                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Headers" />
                                    <TextBlock Opacity="0.7" Text="{Binding EnabledHeaderCount, StringFormat=' ({0})'}" />
                                </StackPanel>
                            </TabItem.Header>

                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SectionLabelStyle}" Text="Header" />
                                    <TextBlock Grid.Column="2" Margin="8,0,0,6" Style="{StaticResource SectionLabelStyle}" Text="Value" />
                                    <TextBlock Grid.Column="3" Width="40" Text="" />
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl Margin="0,0,10,0" ItemsSource="{Binding Headers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="1.4*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                              ToolTip="Send this header" />

                                                    <ui:TextBox Grid.Column="1"
                                                                FontFamily="{StaticResource CodeFont}"
                                                                PlaceholderText="X-Example"
                                                                Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                    <ui:TextBox Grid.Column="2"
                                                                Margin="8,0,0,0"
                                                                FontFamily="{StaticResource CodeFont}"
                                                                PlaceholderText="value"
                                                                Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                    <ui:Button Grid.Column="3"
                                                               Margin="8,0,0,0"
                                                               Padding="6"
                                                               Command="{Binding DataContext.RemoveHeaderCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding}"
                                                               ToolTip="Remove">
                                                        <ui:SymbolIcon FontSize="14" Symbol="Delete24" />
                                                    </ui:Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <ui:Button Grid.Row="2"
                                           Margin="0,8,0,0"
                                           HorizontalAlignment="Left"
                                           Command="{Binding AddHeaderCommand}"
                                           Content="Add header">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Add24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                        </TabItem>

                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Tests" />
                                    <TextBlock Opacity="0.7" Text="{Binding EnabledAssertionCount, StringFormat=' ({0})'}" />
                                </StackPanel>
                            </TabItem.Header>

                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Margin="0,0,0,8"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Checked after every Send and every Run. Unticked rows are skipped." />

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl Margin="0,0,10,0" ItemsSource="{Binding Assertions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="170" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                              ToolTip="Run this check" />

                                                    <ComboBox Grid.Column="1"
                                                              ItemsSource="{Binding TargetOptions}"
                                                              SelectedItem="{Binding Target, Mode=TwoWay}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Converter={StaticResource AssertionLabel}}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>

                                                    <!-- Header name or JSON path; collapses (and takes its gap with it) for other targets. -->
                                                    <ui:TextBox Grid.Column="2"
                                                                Width="120"
                                                                Margin="8,0,0,0"
                                                                FontFamily="{StaticResource CodeFont}"
                                                                PlaceholderText="{Binding SelectorPlaceholder}"
                                                                Text="{Binding Selector, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                Visibility="{Binding ShowsSelector, Converter={StaticResource BoolToVis}}" />

                                                    <ComboBox Grid.Column="3"
                                                              Margin="8,0,0,0"
                                                              ItemsSource="{Binding OperatorOptions}"
                                                              SelectedItem="{Binding Operator, Mode=TwoWay}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Converter={StaticResource AssertionLabel}}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>

                                                    <ui:TextBox Grid.Column="4"
                                                                Margin="8,0,0,0"
                                                                FontFamily="{StaticResource CodeFont}"
                                                                PlaceholderText="expected value"
                                                                Text="{Binding Expected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                Visibility="{Binding ShowsExpected, Converter={StaticResource BoolToVis}}" />

                                                    <ui:Button Grid.Column="5"
                                                               Margin="8,0,0,0"
                                                               Padding="6"
                                                               Command="{Binding DataContext.RemoveAssertionCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding}"
                                                               ToolTip="Remove">
                                                        <ui:SymbolIcon FontSize="14" Symbol="Delete24" />
                                                    </ui:Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <ui:Button Grid.Row="2"
                                           Margin="0,8,0,0"
                                           HorizontalAlignment="Left"
                                           Command="{Binding AddAssertionCommand}"
                                           Content="Add test">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Add24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <GridSplitter Grid.Row="3"
                                  Height="6"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Background="Transparent"
                                  ResizeBehavior="PreviousAndNext" />

                    <!-- ================= Response ================= -->
                    <Border Grid.Row="4"
                            Margin="12,0,12,10"
                            Padding="12"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            DataContext="{Binding Response}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <WrapPanel Margin="0,0,76,0"
                                            Visibility="{Binding HasResponse, Converter={StaticResource BoolToVis}}">
                                    <Border Padding="8,2"
                                            Background="{Binding StatusCategory, Converter={StaticResource StatusBrush}}"
                                            CornerRadius="4"
                                            Visibility="{Binding HasError, Converter={StaticResource InverseBoolToVis}}">
                                        <TextBlock FontWeight="SemiBold"
                                                   Foreground="White"
                                                   Text="{Binding StatusText}" />
                                    </Border>

                                    <TextBlock Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding ElapsedText}" />

                                    <TextBlock Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding SizeText}" />

                                    <TextBlock Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Text="{Binding TestSummary}"
                                               Visibility="{Binding HasTests, Converter={StaticResource BoolToVis}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Foreground" Value="#D9534F" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AllTestsPassed}" Value="True">
                                                        <Setter Property="Foreground" Value="#3FA55A" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="#D9534F"
                                               Text="{Binding Error}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                                    <!-- Feedback after Save: wraps, because a path is worth reading in full. -->
                                    <TextBlock Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding SaveNote}"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SaveNote}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </WrapPanel>

                                <StackPanel HorizontalAlignment="Right"
                                            Orientation="Horizontal"
                                            Visibility="{Binding HasResponse, Converter={StaticResource BoolToVis}}">
                                    <ui:Button Padding="6,2"
                                               AutomationProperties.Name="Save response to a file"
                                               Command="{Binding SaveToFileCommand}"
                                               ToolTip="Save the response body to a file">
                                        <ui:SymbolIcon FontSize="14" Symbol="Save24" />
                                    </ui:Button>

                                    <ui:Button Margin="4,0,0,0"
                                               Padding="6,2"
                                               AutomationProperties.Name="Copy response body"
                                               Command="{Binding DataContext.CopyResponseBodyCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                               ToolTip="Copy response body">
                                        <ui:SymbolIcon FontSize="14" Symbol="Copy24" />
                                    </ui:Button>
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Row="1"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Send the request to see the response here."
                                       Visibility="{Binding HasResponse, Converter={StaticResource InverseBoolToVis}}" />

                            <TabControl Grid.Row="1" Visibility="{Binding HasResponse, Converter={StaticResource BoolToVis}}">
                                <TabItem Header="Preview">
                                    <Grid>
                                        <ctrl:JsonEditor Margin="0,8,0,0"
                                                         BoundText="{Binding PrettyBody, Mode=OneWay}"
                                                         IsReadOnly="True"
                                                         Style="{StaticResource JsonEditorStyle}"
                                                         Visibility="{Binding IsBinary, Converter={StaticResource InverseBoolToVis}}" />

                                        <TextBlock Margin="0,16,0,0"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Top"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding BinaryNotice}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding IsBinary, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Raw">
                                    <TextBox Margin="0,8,0,0"
                                             IsReadOnly="True"
                                             Style="{StaticResource CodeEditorStyle}"
                                             Text="{Binding RawBody, Mode=OneWay}"
                                             TextWrapping="Wrap" />
                                </TabItem>
                                <TabItem Header="Headers">
                                    <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl Margin="0,0,10,0" ItemsSource="{Binding Headers}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="220" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   FontFamily="{StaticResource CodeFont}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding Key}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1"
                                                                   FontFamily="{StaticResource CodeFont}"
                                                                   FontSize="12"
                                                                   Text="{Binding Value}"
                                                                   TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Tests"
                                         Visibility="{Binding HasTests, Converter={StaticResource BoolToVis}}">
                                    <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding TestResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="24" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0"
                                                                   FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                    <Setter Property="Text" Value="✕" />
                                                                    <Setter Property="Foreground" Value="#D9534F" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Passed}" Value="True">
                                                                            <Setter Property="Text" Value="✓" />
                                                                            <Setter Property="Foreground" Value="#3FA55A" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <TextBlock Grid.Column="1"
                                                                   FontFamily="{StaticResource CodeFont}"
                                                                   FontSize="12"
                                                                   Text="{Binding Message}"
                                                                   TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================= Status bar ================= -->
        <Border Grid.Row="3"
                Padding="12,5"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding StatusMessage}"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="1"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding WorkspacePath}"
                           ToolTip="Collections are saved here as JSON" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
