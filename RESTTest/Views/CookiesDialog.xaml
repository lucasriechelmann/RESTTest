<ui:FluentWindow x:Class="RESTTest.Views.CookiesDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:RESTTest.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:CookiesViewModel}"
                 Title="Cookies"
                 Width="1000"
                 Height="560"
                 MinWidth="900"
                 MinHeight="360"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Cookies" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="20,4,20,12">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Cookie jar" />

            <CheckBox Margin="0,8,0,0"
                      Content="Keep cookies and send them on later requests"
                      IsChecked="{Binding Enabled, Mode=TwoWay}" />

            <TextBlock Margin="0,4,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding StateNote}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="20,0,20,0">
            <TextBlock Margin="0,32,0,0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="The jar is empty. Cookies a server sets in a response appear here."
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasCookies, Converter={StaticResource InverseBoolToVis}}" />

            <Grid Visibility="{Binding HasCookies, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--
                    One column set for the header and every row. Fixed and star columns only: an Auto
                    column is measured per row and the cells stop lining up with their headers.
                -->
                <Grid Grid.Row="0" Margin="10,0,24,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="125" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Host" />
                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Name" />
                    <TextBlock Grid.Column="2" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Value" />
                    <TextBlock Grid.Column="3" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Path" />
                    <TextBlock Grid.Column="4" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Expires" />
                    <TextBlock Grid.Column="5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Flags" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl Margin="0,0,12,0" ItemsSource="{Binding Cookies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,4"
                                        Padding="10,6"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="125" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="{Binding Domain}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Domain}" />
                                        <TextBlock Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="{StaticResource CodeFont}" FontSize="12" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                        <TextBlock Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="{StaticResource CodeFont}" FontSize="12" Text="{Binding Value}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                                        <TextBlock Grid.Column="3" Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="{StaticResource CodeFont}" FontSize="12" Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                        <TextBlock Grid.Column="4" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ExpiresText}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="5" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding FlagsText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FlagsText}" />

                                        <ui:Button Grid.Column="6"
                                                   Padding="6"
                                                   AutomationProperties.Name="Delete cookie"
                                                   Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                   CommandParameter="{Binding}"
                                                   ToolTip="Delete this cookie">
                                            <ui:SymbolIcon FontSize="14" Symbol="Delete24" />
                                        </ui:Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Margin="20,12,20,20">
            <ui:Button HorizontalAlignment="Left"
                       Command="{Binding ClearAllCommand}"
                       Content="Clear all">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Delete24" />
                </ui:Button.Icon>
            </ui:Button>

            <ui:Button MinWidth="92"
                       HorizontalAlignment="Right"
                       Appearance="Primary"
                       Content="Close"
                       IsDefault="True"
                       Click="OnClose" />
        </Grid>
    </Grid>
</ui:FluentWindow>
