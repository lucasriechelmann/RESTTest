<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- The exe's own icon (Explorer, taskbar, Alt+Tab). -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!--
      Release identity. The version is the one place a release number lives: build/release.ps1
      reads it from here for the installer and file names, and the git tag is v$(Version).
    -->
    <Version>1.0.0</Version>
    <Product>RESTTest</Product>
    <AssemblyTitle>RESTTest</AssemblyTitle>
    <Description>A no-login REST client for Windows with collection-wide base URLs.</Description>
    <Authors>Lucas Riechelmann Ramos</Authors>
    <Copyright>Copyright © 2026 Lucas Riechelmann Ramos</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compiled into the assembly so the window and title bar can show it via a pack URI. -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Loaded at runtime via GetManifestResourceStream by Controls/JsonEditor.cs. -->
    <None Remove="Resources\Json.xshd" />
    <EmbeddedResource Include="Resources\Json.xshd" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
